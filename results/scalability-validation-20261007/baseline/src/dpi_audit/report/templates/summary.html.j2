<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>DPI interface audit summary</title>
<style>
:root{--bg:#fbfaf7;--fg:#1d1f24;--muted:#5b616e;--line:#d9d6cf;--card:#ffffff;--accent:#1f5fae;--warn:#8a5a00;--warnbg:#fff4dc;--err:#a3202a;--errbg:#fde8ea;--ok:#1f6b3a;--chip:#eeebe4}
@media (prefers-color-scheme:dark){:root{--bg:#15171b;--fg:#e8e6e1;--muted:#a3a8b3;--line:#33363d;--card:#1d2026;--accent:#8ab4f8;--warn:#f0c36b;--warnbg:#3a2e14;--err:#ff8f96;--errbg:#3d1d21;--ok:#7fd49c;--chip:#2a2d34}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font:15px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,"Noto Sans","Noto Sans Devanagari",sans-serif}
main{max-width:1280px;margin:0 auto;padding:16px}
h1{font-size:1.5rem;margin:.2rem 0}
h2{font-size:1.15rem;margin:2rem 0 .5rem;border-bottom:1px solid var(--line);padding-bottom:.25rem}
.banner{border:1px solid var(--line);background:var(--card);padding:12px 14px;border-radius:8px;margin:12px 0}
.banner.pilot{background:var(--warnbg);border-color:var(--warn)}
.muted{color:var(--muted)}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px}
.stat{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:10px 12px}
.stat b{display:block;font-size:1.3rem}
.controls{display:flex;flex-wrap:wrap;gap:10px;align-items:end;margin:10px 0}
label{font-size:.85rem;color:var(--muted);display:flex;flex-direction:column;gap:2px}
select,input{font:inherit;color:var(--fg);background:var(--card);border:1px solid var(--line);border-radius:6px;padding:5px 8px}
.tablewrap{overflow-x:auto;border:1px solid var(--line);border-radius:8px;background:var(--card)}
table{border-collapse:collapse;width:100%;font-size:.86rem}
th,td{padding:6px 8px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
th{position:sticky;top:0;background:var(--card);z-index:1}
td.n{text-align:right;font-variant-numeric:tabular-nums}
.chip{display:inline-block;background:var(--chip);border-radius:999px;padding:0 8px;font-size:.78rem}
.w-error{background:var(--errbg);color:var(--err)}
.w-warning{background:var(--warnbg);color:var(--warn)}
details{margin:6px 0}
a{color:var(--accent)}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
@media (max-width:640px){th,td{padding:5px}}
</style>
</head>
<body>
<main>
<h1>DPI/DPG interface audit — summary</h1>
<p class="muted">Generated {{ generated }} · codebook {{ cb.meta.id }} v{{ cb.version }} ({{ 'frozen' if fz.frozen else 'NOT frozen: ' ~ fz.reason }}) · mode {{ manifest.mode }}</p>

<div class="banner {{ 'pilot' if label != 'research' else '' }}" role="note">
<strong>Run label: {{ label }}.</strong>
{% if label != 'research' %}These results come from fixtures or a pilot and are not research observations.{% endif %}
Labels describe <em>potential</em> interface barriers within a documented scope. They do not establish WCAG conformance,
screen-reader compatibility, ease of navigation, adoption, satisfaction or causal effects. Availability % uses
present / (present + not observed within scope) among assessable applicable projects; verification % uses
pass / (pass + partial + fail). Unknown, not-tested and not-applicable cases are shown, never counted as zero.
</div>

<div class="grid" aria-label="Run totals">
  <div class="stat"><span class="muted">Enrolled projects</span><b>{{ inventory | length }}</b></div>
  <div class="stat"><span class="muted">Audit failed</span><b>{{ inventory | selectattr('audit_status','equalto','failed') | list | length }}</b></div>
  <div class="stat"><span class="muted">UI not applicable (non-web)</span><b>{{ inventory | selectattr('ui_applicability','equalto','not_applicable') | list | length }}</b></div>
  <div class="stat"><span class="muted">Pages rendered</span><b>{{ inventory | sum(attribute='pages_rendered') }}</b></div>
  <div class="stat"><span class="muted">Coverage warnings</span><b>{{ warnings | length }}</b></div>
</div>

<h2 id="features">Feature summary</h2>
<div class="controls" role="group" aria-label="Filters">
  <label>Category <select id="f-cat"><option value="">All</option>{% for k, v in categories.items() %}<option value="{{ k }}">{{ k }} — {{ v }}</option>{% endfor %}</select></label>
  <label>Label <select id="f-label"><option value="">All</option><option value="wcag_related">WCAG-related</option><option value="ux_research_indicator">UX research indicator</option></select></label>
  <label>Show features with <select id="f-status"><option value="">any results</option><option value="fail">≥1 fail</option><option value="partial">≥1 partial</option><option value="unknown">≥1 unknown</option><option value="not_found">≥1 not observed</option><option value="review">manual review flagged</option></select></label>
  <label>Search <input id="f-q" type="search" placeholder="ID or name"></label>
  <span class="muted" id="f-count" aria-live="polite"></span>
</div>
<div class="tablewrap">
<table id="feat">
<caption class="muted" style="text-align:left;padding:6px 8px">Counts are projects (project-level rollups). Hover IDs for definitions.</caption>
<thead><tr>
<th scope="col">Feature</th><th scope="col">Label</th>
<th scope="col">Present</th><th scope="col">Not observed</th><th scope="col">Unknown</th><th scope="col">N/A</th><th scope="col">Avail. %</th>
<th scope="col">Pass</th><th scope="col">Partial</th><th scope="col">Fail</th><th scope="col">Not tested</th><th scope="col">Pass %</th>
<th scope="col">Runtime-assessed</th><th scope="col">Notes</th>
</tr></thead>
<tbody>
{% for s in summary %}
<tr data-cat="{{ s.category }}" data-label="{{ s.label }}" data-fail="{{ s.n_fail }}" data-partial="{{ s.n_partial }}" data-unknown="{{ s.n_unknown }}" data-nf="{{ s.n_not_found_in_scope }}" data-review="{{ s.n_manual_review_flagged }}" data-q="{{ (s.feature_id ~ ' ' ~ s.feature_name) | lower }}">
<td><abbr title="{{ (features | selectattr('id','equalto',s.feature_id) | first).definition }}">{{ s.feature_id }}</abbr> {{ s.feature_name }}{% if s.wcag_refs %} <span class="chip">WCAG {{ s.wcag_refs }}</span>{% endif %}</td>
<td>{{ 'WCAG-related' if s.label == 'wcag_related' else 'UX indicator' }}</td>
<td class="n">{{ s.n_present }}</td><td class="n">{{ s.n_not_found_in_scope }}</td><td class="n">{{ s.n_unknown }}</td><td class="n">{{ s.n_not_applicable }}</td>
<td class="n">{% if s.availability_semantics == 'subject_presence' %}<span class="muted" title="verification-only feature">n/a</span>{% else %}{{ s.pct_present_of_assessable }}{% if s.availability_denominator %}<span class="muted"> /{{ s.availability_denominator }}</span>{% endif %}{% endif %}</td>
<td class="n">{{ s.n_pass }}</td><td class="n">{{ s.n_partial }}</td><td class="n">{{ s.n_fail }}</td><td class="n">{{ s.n_not_tested }}</td>
<td class="n">{{ s.pct_pass_of_verified }}{% if s.verification_denominator %}<span class="muted"> /{{ s.verification_denominator }}</span>{% endif %}</td>
<td class="n">{{ s.n_runtime_assessed }}</td>
<td class="muted">{{ s.interpretation_notes }}</td>
</tr>
{% endfor %}
</tbody>
</table>
</div>

<h2 id="warnings">Coverage warnings ({{ warnings | length }})</h2>
{% if warnings %}
<div class="tablewrap"><table>
<thead><tr><th scope="col">Project</th><th scope="col">Level</th><th scope="col">Message</th></tr></thead>
<tbody>{% for w in warnings %}<tr><td>{{ w.project_id }}</td><td><span class="chip w-{{ w.level }}">{{ w.level }}</span></td><td>{{ w.message }}</td></tr>{% endfor %}</tbody>
</table></div>
{% else %}<p>No coverage warnings.</p>{% endif %}

<h2 id="inventory">Project inventory</h2>
<div class="tablewrap"><table>
<thead><tr><th scope="col">Project</th><th scope="col">Status</th><th scope="col">UI applicability</th><th scope="col">Websites (status)</th><th scope="col">Pages rendered/sampled</th><th scope="col">Repository (commit)</th><th scope="col">Repo↔deployment</th><th scope="col">Type / country (as supplied)</th></tr></thead>
<tbody>{% for i in inventory %}<tr>
<td><a href="projects/{{ i.project_id }}/report.md">{{ i.project_id }}</a></td><td>{{ i.audit_status }}</td>
<td>{{ i.ui_applicability }}<br><span class="muted">{{ i.ui_applicability_reason }}</span></td>
<td>{% for u in i.websites %}{{ u }} <span class="chip">{{ i.website_types[loop.index0] }}: {{ i.website_status[loop.index0] }}</span><br>{% endfor %}</td>
<td class="n">{{ i.pages_rendered }}/{{ i.pages_sampled }}</td>
<td>{% for r in i.repositories %}{{ r }}{% if i.source_commit[loop.index0] %} <code>{{ i.source_commit[loop.index0][:10] }}</code>{% endif %}<br>{% endfor %}</td>
<td>{{ i.deployment_repository_relationship }}</td><td>{{ i.project_type }} / {{ i.country }}</td>
</tr>{% endfor %}</tbody>
</table></div>

<h2 id="files">Files</h2>
<ul>
<li><code>project_inventory.csv</code>, <code>project_features.csv</code> (long form, project and interface rows), <code>feature_matrix.csv</code>, <code>feature_summary.csv</code>{% for f in strata_files %}, <code>{{ f }}</code>{% endfor %}, <code>feature_summary_by_method.csv</code>, <code>category_counts.csv</code>, <code>measurements.csv</code>, <code>pages.csv</code></li>
<li><code>observations.jsonl</code> — raw evidence-backed observations; <code>projects/&lt;id&gt;/</code> — per-project reports and evidence</li>
<li><code>methodology.md</code>, <code>codebook.yaml</code>, <code>manual_review.csv</code> (stratified review queue)</li>
</ul>
<p class="muted">Tool versions: {% for k, v in tool_versions.items() %}{{ k }}={{ v | join(',') }} {% endfor %}</p>
</main>
<script>
(function(){
  var rows = Array.prototype.slice.call(document.querySelectorAll('#feat tbody tr'));
  var c = document.getElementById('f-cat'), l = document.getElementById('f-label'), s = document.getElementById('f-status'), q = document.getElementById('f-q'), n = document.getElementById('f-count');
  function apply(){
    var shown = 0;
    rows.forEach(function(r){
      var ok = (!c.value || r.dataset.cat === c.value) && (!l.value || r.dataset.label === l.value);
      var st = s.value;
      if (ok && st === 'fail') ok = +r.dataset.fail > 0;
      if (ok && st === 'partial') ok = +r.dataset.partial > 0;
      if (ok && st === 'unknown') ok = +r.dataset.unknown > 0;
      if (ok && st === 'not_found') ok = +r.dataset.nf > 0;
      if (ok && st === 'review') ok = +r.dataset.review > 0;
      if (ok && q.value) ok = r.dataset.q.indexOf(q.value.toLowerCase()) >= 0;
      r.hidden = !ok; if (ok) shown++;
    });
    n.textContent = shown + ' of ' + rows.length + ' features shown';
  }
  [c, l, s].forEach(function(e){ e.addEventListener('change', apply); });
  q.addEventListener('input', apply);
  apply();
})();
</script>
</body>
</html>
